# ==========================================================
# PochiPochi Environment Configuration
# ==========================================================

# Supabase "PochiPochi" Database Credentials
# Available at: https://supabase.com/dashboard/project/<project-id>/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Self-Hosted J! Archive & TriviaQA API Endpoint (Optional override)
# Defaults to http://10.0.2.2:4000/api/trivia on Android emulator
# and http://localhost:4000/api/trivia on iOS / web
EXPO_PUBLIC_TRIVIA_API_URL=

# Google OAuth Web Client ID (from Google Cloud Console -> Credentials)
# Used for Mobile-First Native Google Sign-In with Supabase
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Battle server WebSocket URL. Leave unset in dev to auto-use your machine on :4001;
# release builds default to wss://pochipochi-battle.fly.dev
# EXPO_PUBLIC_BATTLE_WS_URL=wss://pochipochi-battle.fly.dev

# Public web address of the hosted web build. When set, room invite links open there,
# so friends without the app can join from their browser.
# EXPO_PUBLIC_WEB_URL=https://play.pochipochi.app
