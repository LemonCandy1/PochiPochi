# ==========================================================
# PochiPochi Environment Configuration
# ==========================================================

# Supabase "PochiPochi" Database Credentials
# Available at: https://supabase.com/dashboard/project/<project-id>/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Self-Hosted J! Archive & TriviaQA API Endpoint (Optional override)
# Defaults to http://10.0.2.2:4000/api/trivia on Android emulator
# and http://localhost:4000/api/trivia on iOS / web
EXPO_PUBLIC_TRIVIA_API_URL=
